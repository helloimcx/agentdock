{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "管家 LAC 委派与持续跟踪",
    "locale": "zh-CN",
    "quality_profile": "showcase"
  },
  "lanes": [
    {"id": "coordination", "label": "管家协调与用户交付"},
    {"id": "execution", "label": "Core 内部委派与单轮执行"},
    {"id": "tracking", "label": "跨重启的持续跟踪"}
  ],
  "mainPath": ["origin", "butler", "ledger", "dispatch", "worker", "report", "review", "notify"],
  "nodes": [
    {"id": "origin", "lane": "coordination", "col": 0, "type": "frontend", "label": "用户交代目标", "sublabel": "通过管家 Channel"},
    {"id": "butler", "lane": "coordination", "col": 1, "type": "backend", "label": "管家 Agent", "sublabel": "选择 Bot 与完成条件"},
    {"id": "ledger", "lane": "coordination", "col": 2, "type": "database", "label": "Core Butler 账本", "sublabel": "Task · Operation · checkpoint", "width": 172},
    {"id": "dispatch", "lane": "execution", "col": 2, "type": "security", "label": "授权与内部派发", "sublabel": "解析已配置 Bot 绑定"},
    {"id": "worker", "lane": "execution", "col": 3, "type": "backend", "label": "工作区 Agent", "sublabel": "独立会话执行一轮"},
    {"id": "report", "lane": "execution", "col": 4, "type": "messagebus", "label": "Worker 回报与检查点", "sublabel": "绑定 operation / run", "width": 172},
    {"id": "review", "lane": "coordination", "col": 4, "type": "backend", "label": "唤醒管家原会话", "sublabel": "核验 / 追问 / 异常"},
    {"id": "notify", "lane": "coordination", "col": 5, "type": "frontend", "label": "管家回复用户", "sublabel": "结论或需要用户决定"},
    {"id": "watch", "lane": "tracking", "col": 4, "type": "database", "label": "持久只读检查计划", "sublabel": "外部任务 ID · nextCheckAt · budget", "width": 148},
    {"id": "check", "lane": "tracking", "col": 2, "type": "backend", "label": "到期检查", "sublabel": "按登记的只读计划"}
  ],
  "edges": [
    {"id": "request", "from": "origin", "to": "butler", "label": "用户指令", "role": "main"},
    {"id": "delegate", "from": "butler", "to": "ledger", "label": "lac butler create / delegate", "role": "main"},
    {"id": "admit", "from": "ledger", "to": "dispatch", "label": "先登记，再提交", "role": "main"},
    {"id": "execute", "from": "dispatch", "to": "worker", "label": "WorkspaceRouter", "role": "main"},
    {"id": "checkpoint", "from": "worker", "to": "ledger", "label": "Side effect ID · phase=checkpoint", "role": "async"},
    {"id": "result", "from": "worker", "to": "report", "label": "lac butler report · phase=final", "role": "main"},
    {"id": "wake", "from": "report", "to": "review", "label": "首轮 / 完成 / 异常", "role": "async"},
    {"id": "deliver", "from": "review", "to": "notify", "label": "核验证据后通知", "role": "main"},
    {"id": "continue", "from": "review", "to": "ledger", "label": "继续处理 / 调整计划", "role": "return"},
    {"id": "waiting", "from": "report", "to": "watch", "label": "按已登记计划续查", "role": "branch"},
    {"id": "due", "from": "watch", "to": "check", "label": "到期原子领取；重启续查", "role": "async"},
    {"id": "query", "from": "check", "to": "dispatch", "label": "查询已有任务，不重复创建", "role": "return"}
  ],
  "semanticChecks": {
    "allowedRoots": ["origin"],
    "allowedTerminals": ["notify"],
    "requiredEdges": [{"from": "watch", "to": "check"}, {"from": "check", "to": "dispatch"}],
    "requiredPaths": [{"from": "origin", "to": "notify"}, {"from": "watch", "to": "worker"}]
  },
  "cards": [
    {"dot": "emerald", "title": "完成以用户目标为准", "items": ["Agent 一轮结束只终结本次运行。建立下载后仍需等待，实际完成并通过核验才关闭目标。"]},
    {"dot": "cyan", "title": "等待由 Core 托管", "items": ["外部任务 ID 可在副作用后先写入 checkpoint；检查时间、预算与租约持久保存。无变化时自动续查，重要变化、完成候选和异常唤醒管家。"]}
  ]
}
