{
  "schema_version": 3,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "AgentDock Task 与 Run 执行状态机",
    "locale": "zh-CN",
    "output": "docs/architecture/agent-run-lifecycle.html",
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-flow",
        "label": "标准执行生命周期",
        "focus": [
          "queued",
          "preparing",
          "running",
          "finalizing",
          "completed"
        ],
        "note": "Run 从排队、环境装配、执行到结果持久化收尾；thread runtime snapshot 从持久 projection 构建。"
      },
      {
        "id": "permission-gate",
        "label": "权限阻断与等待确认",
        "focus": [
          "running",
          "waiting_permission",
          "blocked",
          "canceled"
        ],
        "note": "执行敏感操作时持久化授权状态并挂起；ACP 进程退出后旧授权失效，不会作用到新会话。"
      },
      {
        "id": "recovery-and-terminal",
        "label": "异常重试与终态退出",
        "focus": [
          "running",
          "failed",
          "timed_out",
          "canceled"
        ],
        "note": "运行失败、取消与超时分别收敛；submission 和 delivery 是独立状态域，发送不确定时由 outbox 标记 unknown。"
      }
    ]
  },
  "states": [
    {
      "id": "queued",
      "type": "start",
      "label": "排队中 (Queued)",
      "step": "01",
      "tag": "entry"
    },
    {
      "id": "preparing",
      "type": "active",
      "label": "准备中 (Preparing)",
      "step": "02",
      "tag": "init"
    },
    {
      "id": "running",
      "type": "active",
      "label": "执行中 (Running)",
      "step": "03",
      "tag": "work"
    },
    {
      "id": "finalizing",
      "type": "decision",
      "label": "收尾中 (Finalizing)",
      "step": "04",
      "tag": "verify"
    },
    {
      "id": "completed",
      "type": "success",
      "label": "已完成 (Completed)",
      "step": "05",
      "tag": "done"
    },
    {
      "id": "waiting_permission",
      "type": "waiting",
      "label": "等待授权 (Waiting)",
      "tag": "pause"
    },
    {
      "id": "blocked",
      "type": "waiting",
      "label": "等待输入 (Blocked)",
      "tag": "wait"
    },
    {
      "id": "failed",
      "type": "failure",
      "label": "执行失败 (Failed)",
      "tag": "retryable"
    },
    {
      "id": "canceled",
      "type": "failure",
      "label": "已取消 (Canceled)",
      "tag": "terminal"
    },
    {
      "id": "timed_out",
      "type": "failure",
      "label": "超时终止 (Timed Out)",
      "tag": "terminal"
    }
  ],
  "transitions": [
    {
      "id": "queued-preparing",
      "from": "queued",
      "to": "preparing",
      "label": "开始准备"
    },
    {
      "id": "preparing-running",
      "from": "preparing",
      "to": "running",
      "label": "环境就绪"
    },
    {
      "id": "running-finalizing",
      "from": "running",
      "to": "finalizing",
      "label": "执行结束"
    },
    {
      "id": "finalizing-completed",
      "from": "finalizing",
      "to": "completed",
      "label": "收尾成功"
    },
    {
      "id": "permission-needed",
      "from": "running",
      "to": "waiting_permission",
      "variant": "security"
    },
    {
      "id": "run-blocked",
      "from": "finalizing",
      "to": "blocked",
      "variant": "default"
    },
    {
      "id": "running-failed",
      "from": "running",
      "to": "failed",
      "variant": "security"
    },
    {
      "id": "failed-retry",
      "from": "failed",
      "to": "running",
      "variant": "emphasis"
    },
    {
      "id": "permission-cancel",
      "from": "waiting_permission",
      "to": "canceled",
      "variant": "security"
    },
    {
      "id": "block-timeout",
      "from": "blocked",
      "to": "timed_out",
      "variant": "security"
    }
  ],
  "cards": [],
  "mainPath": [
    "queued",
    "preparing",
    "running",
    "finalizing",
    "completed"
  ]
}
