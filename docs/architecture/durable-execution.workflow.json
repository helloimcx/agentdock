      "col": 2,
      "type": "backend",
      "label": "全局 Durable 进程",
      "width": 150
    },
    {
      "id": "pi_store",
      "lane": "durable",
      "col": 3,
      "type": "database",
      "label": "全局 SQLite",
      "width": 175
    },
    {
      "id": "restart",
      "lane": "recovery",
      "col": 2,
      "type": "backend",
      "label": "启动对账",
      "width": 150
