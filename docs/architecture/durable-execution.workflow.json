{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "AgentDock 提交去重、投递恢复、运行快照与 Pi Durable SQLite",
    "locale": "zh-CN",
    "quality_profile": "showcase",
    "output": "docs/architecture/durable-execution-workflow.html"
  },
  "lanes": [
    {
      "id": "view",
      "label": "聊天历史分页、运行快照与慢消费者恢复"
    },
    {
      "id": "core",
      "label": "提交、执行与最终报告投递"
    },
    {
      "id": "durable",
      "label": "可选 Pi Durable SQLite"
    },
    {
      "id": "recovery",
      "label": "重启与不确定结果",
      "variant": "exception"
    }
  ],
  "mainPath": [
    "input",
    "admit",
    "execute",
    "outbox",
    "send",
    "ack"
  ],
