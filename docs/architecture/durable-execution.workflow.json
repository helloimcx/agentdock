  "edges": [
    {
      "from": "input",
      "to": "admit",
      "role": "main"
    },
    {
      "from": "admit",
      "to": "execute",
      "role": "main"
    },
    {
      "from": "execute",
      "to": "outbox",
      "role": "main"
    },
    {
      "from": "outbox",
      "to": "send",
      "role": "main"
    },
    {
      "from": "send",
      "to": "ack",
      "role": "main"
    },
    {
      "from": "admit",
      "to": "snapshot",
      "label": "提交后可见",
      "role": "branch"
    },
    {
      "from": "chat",
      "to": "thread_api",
      "label": "limit+游标",
      "role": "async"
    },
    {
      "from": "thread_api",
      "to": "clients",
      "label": "seq 有序合并",
      "role": "async"
    },
    {
      "from": "chat",
      "to": "snapshot",
      "label": "SSE limit=50",
      "role": "async"
    },
    {
      "from": "snapshot",
      "to": "backpressure",
      "label": "快照修订",
      "role": "async"
    },
    {
      "from": "backpressure",
      "to": "clients",
      "label": "drain 后发送",
      "role": "async"
    },
    {
      "from": "execute",
      "to": "harness",
      "label": "显式启用",
      "role": "branch"
    },
    {
      "from": "harness",
      "to": "pi_store",
      "label": "检查点",
      "role": "async"
    },
    {
      "from": "harness",
      "to": "execute",
      "label": "写入审批 RPC",
      "role": "async"
    },
    {
      "from": "harness",
      "to": "restart",
      "label": "进程重启",
      "role": "branch"
    },
    {
      "from": "send",
      "to": "unknown",
      "label": "确认丢失",
      "role": "error"
    }
  ]
}
