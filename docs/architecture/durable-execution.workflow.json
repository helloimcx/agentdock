    "requiredEdges": [
      {
        "from": "harness",
        "to": "execute"
      }
    ]
  },
  "nodes": [
    {
      "id": "input",
      "lane": "core",
      "col": 0,
      "type": "frontend",
      "label": "提交入口",
      "width": 150
    },
    {
      "id": "admit",
      "lane": "core",
      "col": 1,
      "type": "database",
      "label": "事务接收",
      "width": 150
    },
    {
      "id": "execute",
      "lane": "core",
      "col": 2,
      "type": "backend",
      "label": "运行路由",
      "width": 150
    },
    {
      "id": "outbox",
      "lane": "core",
      "col": 3,
      "type": "database",
      "label": "持久投递单",
      "width": 150
    },
    {
      "id": "send",
      "lane": "core",
      "col": 4,
      "type": "external",
      "label": "渠道发送",
      "width": 150
    },
    {
      "id": "ack",
      "lane": "core",
      "col": 5,
      "type": "database",
      "label": "保存确认",
      "width": 150
    },
    {
      "id": "snapshot",
      "lane": "view",
      "col": 2,
      "type": "backend",
      "label": "窗口运行快照",
