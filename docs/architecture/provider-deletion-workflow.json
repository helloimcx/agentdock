  "cards": [
    {
      "dot": "emerald",
      "title": "Concurrency Boundary",
      "items": [
        "Provider deletion holds the controller promise-chain queue while it reads references, persists a replacement, and deletes the provider row.",
        "Runtime-config writers use the same queue, so none can add the old provider reference during that critical section."
      ]
    },
    {
      "dot": "amber",
      "title": "Failure Semantics",
      "items": [
        "A config-save failure prevents provider deletion; a delete failure restores the captured config before the error is returned.",
        "A process crash between successful repoint and delete may leave the old provider row unused, while references still point to a valid replacement."
      ]
    }
  ]
