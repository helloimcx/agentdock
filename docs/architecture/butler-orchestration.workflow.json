{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "管家 Channel Bot 委托与跟踪",
    "locale": "zh-CN",
    "output": "docs/architecture/butler-orchestration.html",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "user",
      "label": "用户与管家 Bot"
    },
    {
      "id": "core",
      "label": "Local AI Core 持久协调"
    },
    {
      "id": "channel",
      "label": "Lark 消息通道"
    },
    {
      "id": "managed",
      "label": "受管 Bot 与工作区 Agent"
    }
  ],
  "mainPath": [
    "request",
    "manager-bot",
    "admit",
    "dispatch",
    "message",
    "target",
    "execute",
    "result",
    "reconcile",
    "review"
  ],
  "nodes": [
    {
      "id": "request",
      "lane": "user",
      "col": 0,
      "type": "external",
      "label": "用户命令",
      "sublabel": "管家 Bot 对话",
      "width": 140
    },
    {
      "id": "manager-bot",
      "lane": "user",
      "col": 1,
      "type": "backend",
      "label": "管家 Bot",
      "sublabel": "具体 Lark bot 身份",
      "width": 140
    },
    {
      "id": "admit",
      "lane": "core",
      "col": 2,
      "type": "database",
      "label": "持久任务",
      "sublabel": "bot 身份 / 双向群名 / 路由",
      "width": 150
    },
    {
      "id": "dispatch",
      "lane": "core",
      "col": 3,
      "type": "backend",
      "label": "消息分派",
      "sublabel": "构造已验证的有向委托",
      "width": 150
    },
    {
      "id": "message",
      "lane": "channel",
      "col": 3,
      "type": "cloud",
      "label": "Lark 群消息",
      "sublabel": "显式 @ 目标 bot",
      "width": 140
    },
    {
      "id": "target",
      "lane": "managed",
      "col": 3,
      "type": "backend",
      "label": "目标 Bot 网关",
      "sublabel": "接收 Bot 消息 · 校验 Butler",
      "width": 150
    },
    {
      "id": "execute",
      "lane": "managed",
      "col": 4,
      "type": "backend",
      "label": "WorkspaceRouter + ACP",
      "sublabel": "沿用目标 Agent 权限",
      "width": 170
    },
    {
      "id": "result",
      "lane": "channel",
      "col": 4,
      "type": "cloud",
      "label": "Bot 回执消息",
      "sublabel": "进展 / 结果 / 取消状态",
      "width": 150
    },
    {
      "id": "reconcile",
      "lane": "core",
      "col": 4,
      "type": "backend",
      "label": "回调校验与跟踪",
      "sublabel": "接收应用下校验发送方 / run",
      "width": 170
    },
    {
      "id": "review",
      "lane": "user",
      "col": 4,
      "type": "frontend",
      "label": "持续汇报与验收",
      "sublabel": "结果摘要 / 按标准确认",
      "width": 170
    }
  ],
  "edges": [
    {
      "id": "user-command",
      "from": "request",
      "to": "manager-bot",
      "label": "命令 / 跟进 / 验收"
    },
    {
      "id": "bot-ingress",
      "from": "manager-bot",
      "to": "admit",
      "label": "带具体管家 bot 身份"
    },
    {
      "id": "persist",
      "from": "admit",
      "to": "dispatch",
      "label": "requestId 幂等与目标快照"
    },
    {
      "id": "send",
      "from": "dispatch",
      "to": "message",
      "label": "发送应用按群名解析 ID 后 @目标",
      "variant": "emphasis"
    },
    {
      "id": "receive",
      "from": "message",
      "to": "target",
      "route": "straight"
    },
    {
      "id": "run",
      "from": "target",
      "to": "execute",
      "label": "目标 bot thread / run"
    },
    {
      "id": "observe",
      "from": "execute",
      "to": "result",
      "label": "观察 run 与权限后回执"
    },
    {
      "id": "callback",
      "from": "result",
      "to": "reconcile",
      "label": "目标 bot 身份回传"
    },
    {
      "id": "report",
      "from": "reconcile",
      "to": "review",
      "label": "进展汇报 / 结果摘要 / 用户验收"
    }
  ]
}
