      {
        "id": "acp-execution",
        "label": "会话装配与 ACP 执行",
        "focus": ["policy_resolve", "executor_init", "acp_run", "final_reply"],
        "note": "注入环境变量、动态继承 Provider 配置并驱动模型会话"
