  "cards": [
    {
      "dot": "cyan",
      "title": "触发与策略解耦",
      "items": [
        "SchedulerService 负责 Cron 到期轮询与防重并发检查",
        "平台适配器解析渠道类型与实例 ID，策略引擎裁定本地执行或渠道桥接"
      ]
    },
    {
      "dot": "violet",
      "title": "执行与渠道流式交付",
      "items": [
        "ConversationExecutor 注入环境变量并建立与飞书/微信网关的生命周期绑定",
        "ACP 执行过程、工具进度与最终卡片实时推送到群聊，执行结束自动持久化状态"
      ]
    }
