{
  "name": "@kafca/agentdock",
  "version": "0.1.78",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "bin": {
    "agentdock": "bin/agentdock.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helloimcx/agentdock.git"
  },
  "files": [
    "bin/**",
    "dist/renderer/**",
    "dist-electron/**",
    "build/icon.png",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node scripts/strip-workspace-deps.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "pnpm exec vite --host 127.0.0.1 --port 5173",
    "dev:core": "pnpm build:electron && node scripts/launch-core.mjs",
    "build": "vite build && pnpm build:electron",
    "build:npm": "VITE_LOCAL_AI_CORE_BASE=/api/local/v1 pnpm build",
    "build:web": "vite build",
    "build:renderer": "vite build",
    "build:electron": "node -e \"require('node:fs').rmSync('dist-electron',{recursive:true,force:true})\" && node scripts/write-electron-package.mjs && tsc -p tsconfig.electron.json && tsc-alias -p tsconfig.electron.json && node scripts/copy-managed-skills.mjs",
    "build:core": "pnpm build:electron",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tests/bdd/tsconfig.json --noEmit",
    "test": "pnpm typecheck && pnpm build:renderer && pnpm build:electron && node --test dist-electron/tests/electron/*.test.js dist-electron/tests/contracts/*.test.js dist-electron/tests/integration/*.test.js dist-electron/packages/knowledge-api/test/*.test.js dist-electron/src/pages/Threads/thread-chat-permission.test.js && pnpm test:bdd",
    "test:bdd": "node --import tsx scripts/test-bdd.mjs --config tests/bdd/cucumber.mjs",
    "coverage": "node scripts/coverage.mjs",
    "lint:complexity": "eslint . --format stylish",
    "lint:complexity:gate": "eslint . --format stylish --max-warnings 108",
    "lint:circular": "node scripts/lint-circular.mjs",
    "lint:dead-code": "node scripts/lint-dead-code.mjs",
    "lint:duplicate": "node scripts/lint-duplicate.mjs",
    "lint:file-size": "node scripts/lint-file-size.mjs",
    "lint:function-length": "node scripts/lint-function-length.mjs",
    "lint:gates": "node scripts/lint-circular.mjs --fail && JSCPD_MIN_LINES=10 JSCPD_MIN_TOKENS=60 node scripts/lint-duplicate.mjs --fail && node scripts/lint-dead-code.mjs --fail --max-count 171 && node scripts/lint-file-size.mjs --fail && node scripts/lint-function-length.mjs --fail --max-count 45 && pnpm lint:complexity:gate",
    "e2e:smoke": "pnpm build && node scripts/e2e-smoke.mjs",
    "e2e:compose": "node scripts/e2e-compose.mjs",
    "dist:mac": "pnpm build && electron-builder --mac dmg zip --arm64",
    "dist:win": "pnpm build && electron-builder --win nsis zip --x64",
    "start": "node scripts/dev.mjs",
    "start:core": "node scripts/launch-core.mjs",
    "start:prod": "node scripts/launch-electron.mjs .",
    "preview": "vite preview",
    "preview:web": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.30.0",
    "@anthropic-ai/sandbox-runtime": "0.0.63",
    "@cc/core-sdk": "workspace:*",
    "@cc/plugin-sdk": "workspace:*",
    "@cc/superai-contracts": "workspace:*",
    "@larksuiteoapi/node-sdk": "^1.58.0",
    "@mariozechner/pi-coding-agent": "^0.72.1",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@zed-industries/codex-acp": "^0.12.0",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "i18next": "^25.1.2",
    "lucide-react": "^0.487.0",
    "pi-acp": "^0.0.26",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.5.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "c8": "^10.1.3",
    "electron": "^35.7.5",
    "electron-builder": "^26.8.1",
    "eslint": "^10.8.0",
    "jscpd": "^5.0.12",
    "knip": "^6.29.0",
    "madge": "^8.0.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.23.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.3.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "protobufjs"
    ]
  },
  "build": {
    "appId": "com.helloimcx.agentdock",
    "productName": "AgentDock",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "dist/renderer/**",
      "dist-electron/**",
      "build/icon.png",
      "node_modules/**",
      "package.json"
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "helloimcx",
        "repo": "agentdock",
        "releaseType": "release"
      }
    ]
  }
}
