AGENTDOCK_CLOUD_PORT=9831
AGENTDOCK_CLOUD_DATA_ROOT=/data/agentdock
AGENTDOCK_CLOUD_SQLITE_PATH=/data/agentdock/agentdock-cloud.db
AGENTDOCK_CLOUD_EVENT_BUS=rocketmq
AGENTDOCK_CLOUD_SANDBOX_PROVIDER=opensandbox
AGENTDOCK_SANDBOX_IMAGE=agentdock/pi-sandbox-runtime:local
OPENSANDBOX_BASE_URL=http://opensandbox-server:8090
OPEN_SANDBOX_API_KEY=dev-opensandbox-key
ROCKETMQ_NAMESRV_ADDR=rocketmq-namesrv:9876
ROCKETMQ_ENDPOINTS=rocketmq-proxy:8081
ROCKETMQ_TOPIC=agentdock_events
ROCKETMQ_CONSUMER_GROUP=agentdock-cloud-consumer
