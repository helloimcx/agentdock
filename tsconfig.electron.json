{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@cc/superai-contracts": ["packages/contracts/src/index.ts"],
      "@cc/superai-contracts/*": ["packages/contracts/src/*"],
      "@cc/core-sdk": ["packages/core-sdk/src/index.ts"],
      "@cc/core-sdk/*": ["packages/core-sdk/src/*"],
      "@cc/plugin-sdk": ["packages/plugin-sdk/src/index.ts"],
      "@cc/plugin-sdk/*": ["packages/plugin-sdk/src/*"],
      "@cc/knowledge-api": ["packages/knowledge-api/src/index.ts"]
    },
    "outDir": "dist-electron",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "tsc-alias": {
    "replacers": {
      "base-url": {
        "enabled": false
      }
    }
  },
  "include": [
    "electron/**/*.ts",
    "tests/**/*.ts",
    "shared/**/*.ts",
    "packages/**/*.ts",
    "services/**/*.ts",
    "src/pages/Threads/thread-chat-message-blocks.ts",
    "src/pages/Threads/thread-chat-permission.ts",
    "src/pages/Threads/thread-chat-permission.test.ts",
    "src/lib/session-chat-events.ts",
    "src/components/chat/chat-message-state.ts"
  ]
}
