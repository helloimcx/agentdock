{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tests/**/*.test.ts", "tests/**/*.test.mjs", "scripts/*.mjs"]
    },
    "apps/desktop": {
      "entry": ["src/main.ts", "src/preload.ts"]
    },
    "apps/web": {
      "entry": ["src/main.tsx", "src/App.tsx", "src/**/*.test.ts"]
    },
    "apps/daemon": {
      "entry": ["src/cli/lac.ts", "src/mesh/node-cli.ts"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts"]
    },
    "packages/sdk": {
      "entry": ["src/index.ts"]
    },
    "packages/knowledge": {
      "entry": ["src/index.ts", "test/**/*.test.ts"]
    },
    "packages/plugin-sdk": {
      "entry": ["src/index.ts"]
    }
  },
  "ignoreDependencies": [
    "@cc/core-sdk",
    "@cc/knowledge-api",
    "@cc/plugin-sdk",
    "@cc/superai-contracts",
    "@agentdock/contracts",
    "@agentdock/sdk",
    "@agentdock/knowledge",
    "@agentdock/plugin-sdk",
    "@agentdock/daemon",
    "@agentdock/desktop",
    "@agentdock/web"
  ]
}
